# Lumen provider settings
#
# 1. Copy this file to ".env"  (cp .env.example .env)
# 2. Fill in BASE_URL and API_KEY for each provider you have
# 3. Restart:  node server.js
#
# A provider is active only when its BASE_URL is filled in. Blank = ignored.
# Keys stay on the server. The browser never sees them.
#
# Naming: MOVIES_<NAME>_...  or  SHORTS_<NAME>_...
# NAME is letters and digits only (no underscore). To add another provider,
# copy a block and change NAME. There is no limit.
#
# Per-provider options (all optional except BASE_URL):
#   LABEL             name shown in the app
#   BASE_URL          API root, no trailing slash, e.g. https://api.example.com/v1
#   API_KEY           your key
#   AUTH_HEADER       header that carries the key (default: Authorization)
#   AUTH_PREFIX       text before the key (default: "Bearer "). Use "" for a bare key
#   KEY_QUERY_PARAM   send the key as a ?param instead of a header, e.g. api_key
#   EXTRA_HEADERS     more headers as Name:Value;Name2:Value2

PORT=3000
HOST=127.0.0.1

# ------------------------------------------------------------
# Movies and TV shows
# ------------------------------------------------------------
MOVIES_ALPHA_LABEL=Alpha Movies
MOVIES_ALPHA_BASE_URL=
MOVIES_ALPHA_API_KEY=
MOVIES_ALPHA_AUTH_HEADER=Authorization
MOVIES_ALPHA_AUTH_PREFIX="Bearer "

MOVIES_BRAVO_LABEL=Bravo Movies
MOVIES_BRAVO_BASE_URL=
MOVIES_BRAVO_API_KEY=
# This one sends the key in a header called X-API-Key, with no prefix:
MOVIES_BRAVO_AUTH_HEADER=X-API-Key
MOVIES_BRAVO_AUTH_PREFIX=""

# ------------------------------------------------------------
# Short dramas (each one shows up as a chip in Shorts > Platform)
# ------------------------------------------------------------
SHORTS_ALPHA_LABEL=Alpha Shorts
SHORTS_ALPHA_BASE_URL=
SHORTS_ALPHA_API_KEY=
SHORTS_ALPHA_AUTH_HEADER=Authorization
SHORTS_ALPHA_AUTH_PREFIX="Bearer "

SHORTS_BRAVO_LABEL=Bravo Shorts
SHORTS_BRAVO_BASE_URL=
SHORTS_BRAVO_API_KEY=
# This one takes the key as ?api_key=... in the URL:
SHORTS_BRAVO_KEY_QUERY_PARAM=api_key

SHORTS_CHARLIE_LABEL=Charlie Shorts
SHORTS_CHARLIE_BASE_URL=
SHORTS_CHARLIE_API_KEY=
# SHORTS_CHARLIE_EXTRA_HEADERS=X-Client:lumen;Accept-Language:en
